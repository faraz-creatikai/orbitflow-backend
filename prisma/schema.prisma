  platform    String // INSTAGRAM
  accessToken String  @db.LongText
  igAccountId String
  pageId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
}

model LinkedinAccount {
  id      String @id @default(uuid())
  adminId String @unique
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  // LinkedIn Identity
  linkedinId     String  @unique
  personUrn      String // Required as the 'author' field when publishing (e.g., urn:li:person:12345)
  name           String?
  profilePicture String?
  email          String?
  locale         String?

  // OAuth Credentials 
  // Stored as @db.Text because LinkedIn tokens can exceed 500-1000 characters
  accessToken           String    @db.Text
  accessTokenExpiresAt  DateTime
  refreshToken          String?   @db.Text
  refreshTokenExpiresAt DateTime?

  scopesGranted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledPost {
  id      String @id @default(cuid())
  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id]) // Assumes you have a User model

  // Post Content
  imageUrl String  @db.Text
  caption  String? @db.Text

  // Meta Specifics
  platform    String  @default("INSTAGRAM")
  igAccountId String
  containerId String? // The ID returned by Step 3 (Media Container)
  scheduledId String? // The ID returned by Step 4 (Scheduled Object)

  // Timing
  scheduledTime DateTime
  status        PostStatus @default(SCHEDULED) // Enum: SCHEDULED, PUBLISHED, FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PostStatus {
  SCHEDULED
  PUBLISHED
  FAILED
}

model SalesScript {
