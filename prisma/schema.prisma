// Simple. No engagement noise. url is unique to prevent duplicate saves.

model MinedLead {
  id          String    @id @default(cuid())
  source      String // 'reddit' | 'facebook' | 'instagram'
  author      String? // display name / username
  authorId    String? // platform UID (FB authorId, Reddit u/handle)
  title       String?   @db.VarChar(512)
  content     String    @db.Text // post body / caption
  url         String    @unique // deduplication key
  postContext String? // subreddit name, FB page name, IG hashtag, etc.
  postedAt    DateTime? // original post timestamp if available
  savedAt     DateTime  @default(now())

  @@index([source])
  @@index([savedAt])
  @@map("mined_leads")
}

