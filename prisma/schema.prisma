  Content   String   @db.LongText
  Status    String
  mode      String?  @default("hindi")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAiApiKey {
  id       String     @id @default(uuid())
  provider AIProvider // Re-use your enum (OPENAI, GEMINI, etc.)
  apiKey   String     @db.Text // Store ENCRYPTED
  model    String

  status NormalStatus @default(ACTIVE)

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id]) // Assumes you have a User model

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // This ensures a user can only have ONE master key per provider
  @@unique([adminId, provider])
}

model CRMApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String? // e.g., "Zapier Integration", "Personal Mac Script"
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([adminId])
}

enum ActivityAction {
  create
  update
  delete
  assign
  unassign
  login
  logout
  import
}

enum ActivityEntity {
  customer
  followup
  property
  contact
  admin
}

model ActivityLog {
  id String @id @default(uuid())

  // WHO did it
  adminId  String
  admin    Admin   @relation("AdminActivityLogs", fields: [adminId], references: [id], onDelete: Cascade)
  role     Role? // snapshot of role at the time
  city     String?
  clientId String?

  // WHAT happened
  action ActivityAction
  entity ActivityEntity

  // ON WHICH RECORD (kept as plain strings on purpose — NO foreign key,
  // so the log survives after the customer/followup is deleted)
  entityId   String?
  entityName String? // customerName / followup status etc. for display
  customerId String? // quick reference for customer-linked activities
  followupId String?

  // For assign / unassign : to whom
  targetAdminId  String?
  targetAdminRef Admin?  @relation("AdminActivityTargets", fields: [targetAdminId], references: [id], onDelete: SetNull)

  // Which online-session this activity belongs to (for the timeline)
  sessionId String?
  session   UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  meta      Json?    @default("{}") // changed fields, counts, ip, anything extra
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entity, action, createdAt])
  @@index([clientId, createdAt])
  @@index([customerId])
  @@index([sessionId])
  @@index([createdAt])
}

model UserSession {
  id String @id @default(uuid())

  adminId String
  admin   Admin  @relation("AdminSessions", fields: [adminId], references: [id], onDelete: Cascade)

  clientId String?
  role     Role?

  loginAt     DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  logoutAt    DateTime?
  durationSec Int?
  isOnline    Boolean   @default(true)

  ip        String?
  userAgent String? @db.Text

  activities ActivityLog[]

  @@index([adminId, loginAt])
  @@index([isOnline])
  @@index([clientId, loginAt])
}

// --- Add this Enum ---
enum EnquiryStatus {
  open
  pending
  resolved
  closed
}

// --- Add these New Models ---
model Enquiry {
  id       String        @id @default(uuid())
  ticketId String        @unique // e.g., "TKT-10293" for UI reference
  subject  String
  status   EnquiryStatus @default(open)
  priority String        @default("medium") // low, medium, high, urgent

  customerId String
  customer   Customer @relation("CustomerEnquiries", fields: [customerId], references: [id], onDelete: Cascade)

  messages EnquiryMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model EnquiryMessage {
  id          String @id @default(uuid())
  message     String @db.LongText
  attachments Json?  @default("[]") // For future proofing uploads

  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  // Either adminId OR customerId will be filled depending on who sent the reply
  adminId String?
  admin   Admin?  @relation("AdminEnquiryMessages", fields: [adminId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation("CustomerEnquiryMessages", fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([enquiryId])
  @@index([adminId])
  @@index([customerId])
}

// ------------------------------------------------------------------
// AI CHAT SESSIONS & HISTORY
// ------------------------------------------------------------------
model AgentChatSession {
  id       String  @id @default(uuid())
  title    String  @default("New Conversation")
  isPinned Boolean @default(false)

  // Link to Admin (if an Admin is chatting)
  adminId String?
  admin   Admin?  @relation("AdminChatSessions", fields: [adminId], references: [id], onDelete: Cascade)

  // Link to Customer/Employee (if an Employee is chatting)
  employeeId String?
  employee   Employee? @relation("EmployeeChatSessions", fields: [employeeId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation("CustomerChatSessions", fields: [customerId], references: [id], onDelete: Cascade)

  // The messages inside this specific session
  messages AgentChatHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId])
  @@index([customerId])
  @@index([employeeId])
}

model AgentChatHistory {
  id      String @id @default(uuid())
  role    String // "user", "model", "function"
  content String @db.LongText

  // Link to the parent Chat Session
  sessionId String
  session   AgentChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([sessionId])
}
